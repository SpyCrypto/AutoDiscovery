VITE_AD_MODE=realdeal

# ---------------------------------------------------------------------------
# Midnight Network Selection
# Options: undeployed (local Docker), preview, preprod
# ---------------------------------------------------------------------------
MIDNIGHT_NETWORK=undeployed
VITE_MIDNIGHT_NETWORK=undeployed

# Proof server — always runs locally (handles ZK proofs containing private data)
VITE_PROOF_SERVER_URL=http://localhost:6300

# ---------------------------------------------------------------------------
# Indexer + Node — local (undeployed) defaults; switch to hosted for testnet
# ---------------------------------------------------------------------------
# Local (undeployed): docker compose up
VITE_INDEXER_URL=http://localhost:8088/api/v3/graphql
VITE_INDEXER_WS_URL=ws://localhost:8088/api/v3/graphql/ws
VITE_NODE_URL=http://localhost:9944

# Preview testnet (uncomment to use):
# VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v3/graphql
# VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v3/graphql/ws
# VITE_NODE_URL=https://rpc.preview.midnight.network

# Preprod testnet (uncomment to use):
# VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v3/graphql
# VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v3/graphql/ws
# VITE_NODE_URL=https://rpc.preprod.midnight.network

# ---------------------------------------------------------------------------
# Deployer seed — 64-char hex string derived from your wallet seed phrase
# For testnet: fund the Dust address printed by `npm run deploy` from the faucet
# Faucet (preprod): https://faucet.preprod.midnight.network/
# Faucet (preview): https://faucet.preview.midnight.network/
# ---------------------------------------------------------------------------
DEPLOYER_SEED=

# ---------------------------------------------------------------------------
# Deployed contract addresses
# Auto-filled by: npm run deploy (from autodiscovery-contract/)
# ---------------------------------------------------------------------------
VITE_CONTRACT_DISCOVERY_CORE=
VITE_CONTRACT_DOCUMENT_REGISTRY=
VITE_CONTRACT_COMPLIANCE_PROOF=
VITE_CONTRACT_JURISDICTION_REGISTRY=
VITE_CONTRACT_ACCESS_CONTROL=
VITE_CONTRACT_EXPERT_WITNESS=

# AI service
VITE_AI_SERVICE_URL=
