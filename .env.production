# AutoDiscovery Production Environment Configuration
# Copy this file to .env.production and fill in the deployed contract addresses and endpoints

# ============================================================================
# FRONTEND - RealDeal Configuration
# ============================================================================

# App environment mode
VITE_APP_MODE=realdeal

# Indexer GraphQL endpoint (for reading contract state)
VITE_INDEXER_URL=https://preprod-indexer.midnight.network/api/v1/graphql

# Indexer WebSocket endpoint (for live subscriptions)
VITE_INDEXER_WS=wss://preprod-indexer.midnight.network/api/v1/graphql

# Node RPC endpoint (for transaction submission)
VITE_NODE_URL=https://preprod-node.midnight.network

# Proof server URL (for ZK proof generation)
VITE_PROOF_SERVER_URL=https://preprod-proof-server.midnight.network

# ============================================================================
# CONTRACT ADDRESSES (Deployed on Midnight PreProd)
# ============================================================================
# These must be populated after deployment. Get addresses from deploy logs.

# Discovery Core contract - handles case/step creation and tracking
VITE_CONTRACT_DISCOVERY_CORE=<preprod-contract-address>

# Compliance Proof contract - attests step-level compliance
VITE_CONTRACT_DISCOVERY_PROOF=<preprod-contract-address>

# Document Registry contract - registers and manages documents
VITE_CONTRACT_DOCUMENT_REGISTRY=<preprod-contract-address>

# Access Control contract - manages permission grants/revokes
VITE_CONTRACT_ACCESS_CONTROL=<preprod-contract-address>

# Jurisdiction Registry contract - manages regional legal rules
VITE_CONTRACT_JURISDICTION_REGISTRY=<preprod-contract-address>

# Expert Witness contract - registers and manages expert witnesses
VITE_CONTRACT_EXPERT_WITNESS=<preprod-contract-address>

# ============================================================================
# CLI Configuration (for autodiscovery-cli package)
# ============================================================================

# CLI environment (undeployed | preview | preprod)
CLI_ENV=preprod

# CLI log level (debug | info | warn | error)
CLI_LOG_LEVEL=info

# ============================================================================
# SECURITY & DEPLOYMENT
# ============================================================================

# Set to true to enable verbose logging in production (use carefully)
DEBUG=false

# Maximum concurrent API requests
VITE_MAX_CONCURRENT_REQUESTS=10

# Request timeout (ms)
VITE_REQUEST_TIMEOUT=30000
